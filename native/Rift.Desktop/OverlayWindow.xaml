<Window x:Class="Rift.Desktop.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Rift Companion · Overlay" Width="1280" Height="830" MinWidth="480" MinHeight="320" AllowsTransparency="True" Background="Transparent" Foreground="#E6EDF3" FontFamily="Segoe UI" FontSize="13" ShowActivated="False" ShowInTaskbar="False" WindowStyle="None" ResizeMode="NoResize" UseLayoutRounding="True">
 <DockPanel Margin="12">
  <Border DockPanel.Dock="Top" Background="#E6111A23" CornerRadius="6" Padding="12,8" Margin="4,0,4,6"><StackPanel><DockPanel><Button Content="Masquer" ToolTip="Masquer · Ctrl+X" DockPanel.Dock="Right" Click="OnHide"/><Button Content="Autre écran" ToolTip="Détacher / rattacher · Ctrl+Maj+X" DockPanel.Dock="Right" Click="OnDetach" Margin="0,0,8,0"/><Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnDragStart" MouseMove="OnDragMove" MouseLeftButtonUp="OnDragEnd" LostMouseCapture="OnDragLost" ToolTip="Faire glisser pour déplacer"><TextBlock Text="⠿  RIFT COMPANION · EN PARTIE" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/></Border></DockPanel><TextBlock x:Name="Status" Text="En attente de la partie…" Foreground="#A8BCCB" Margin="0,5,0,0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></Border>
  <Viewbox Stretch="Uniform" StretchDirection="Both"><ItemsControl x:Name="Players" Width="1240" Height="670">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" Rows="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><Border Background="#202E3A" CornerRadius="8" Margin="5" BorderBrush="{Binding Accent}" BorderThickness="0,2,0,0" Padding="12">
    <StackPanel>
     <DockPanel Height="48"><Border Width="36" Height="36" Background="#192630" CornerRadius="4" Margin="0,0,8,0"><Grid><TextBlock Text="?" Foreground="#829CAB" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding ProfileIcon}"/></Grid></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}"/><TextBlock Text="{Binding AccountLevel}" FontSize="11" Foreground="#A3B9C6"/></StackPanel></DockPanel>
     <Border Height="1" Background="{Binding Accent}" Margin="0,7"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><Image Source="{Binding Champion.Icon}" Width="44" Height="44" ToolTip="{Binding Champion.Name}"/><StackPanel Margin="6,0,0,0"><ItemsControl ItemsSource="{Binding Spells}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Image Source="{Binding Icon}" Width="19" Height="19" Margin="0,0,2,2" ToolTip="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Image Source="{Binding Rune.Icon}" Width="19" Height="19" HorizontalAlignment="Left" ToolTip="{Binding Rune}"/></StackPanel></StackPanel><TextBlock Text="{Binding Champion.Name}" FontSize="11" Margin="0,3,0,0"/><TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,3,0,0"><Run Text="{Binding Kills, Mode=OneWay}" Foreground="#32D6A0"/><Run Text=" / "/><Run Text="{Binding Deaths, Mode=OneWay}" Foreground="#FF707B"/><Run Text=" / "/><Run Text="{Binding Assists, Mode=OneWay}" Foreground="#FFB65C"/></TextBlock><TextBlock Text="{Binding ChampionStats}" ToolTip="{Binding OpggDetails}" Foreground="#66DAB6" TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><Image Source="{Binding RankIcon}" Width="45" Height="45"/><TextBlock Text="{Binding Rank}" TextAlignment="Center" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding ServerRank}" ToolTip="{Binding OpggDetails}" FontSize="10" Foreground="#76D4EF" TextWrapping="Wrap" TextAlignment="Center"/><TextBlock Text="{Binding RankedWinRate}" TextAlignment="Center" Foreground="#A3B9C6" FontSize="10" TextWrapping="Wrap"/></StackPanel>
     </Grid>
     <Border Height="1" Background="#475662" Margin="0,8"/>
     <UniformGrid Columns="3"><StackPanel><TextBlock Text="12 HEURES" Foreground="#9FB3C1" FontSize="10"/><TextBlock Text="{Binding Recent12Hours}" TextWrapping="Wrap" FontSize="11" Margin="0,6,4,0"/></StackPanel><StackPanel><TextBlock Text="RÔLE PRINCIPAL" Foreground="#9FB3C1" FontSize="9"/><Image Source="{Binding RoleIcon}" Width="25" Height="25" HorizontalAlignment="Left"/><TextBlock Text="{Binding MainRole}" FontSize="11" TextWrapping="Wrap"/></StackPanel><StackPanel><TextBlock Text="30 JOURS" Foreground="#9FB3C1" FontSize="10"/><TextBlock Text="{Binding Recent30Days}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/></StackPanel></UniformGrid>
     <ItemsControl ItemsSource="{Binding Tags}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#48BD97" BorderThickness="1" CornerRadius="3" Padding="3,1" Margin="0,2"><TextBlock Text="{Binding}" Foreground="#66DAB6" FontSize="10" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="{Binding Notice}" Foreground="#9FB3C1" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
    </StackPanel>
   </Border></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl></Viewbox>
 </DockPanel>
</Window>
