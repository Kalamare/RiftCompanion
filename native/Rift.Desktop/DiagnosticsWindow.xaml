<Window x:Class="Rift.Desktop.DiagnosticsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Diagnostic en direct · Rift Companion" Width="1120" Height="800" MinWidth="860" MinHeight="580" Background="#101820" Foreground="#E6EDF3" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <Style TargetType="ListView"><Setter Property="Background" Value="#192630"/><Setter Property="Foreground" Value="#E6EDF3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style TargetType="GridViewColumnHeader"><Setter Property="Background" Value="#2B404D"/><Setter Property="Foreground" Value="#B6CDD7"/><Setter Property="Padding" Value="8"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  <DataTemplate x:Key="OperationRow"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="100"/><ColumnDefinition Width="240"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Id, StringFormat={}#{0}}"/><TextBlock Grid.Column="1" Text="{Binding Category}"/><TextBlock Grid.Column="2" Text="{Binding Name}"/><TextBlock Grid.Column="3" Text="{Binding Milliseconds, StringFormat={}{0:F0} ms}"/><TextBlock Grid.Column="4" Text="{Binding Result}"/></Grid></DataTemplate>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel><ToggleButton x:Name="PauseButton" Content="Suspendre l’affichage" DockPanel.Dock="Right"/><StackPanel><TextBlock Text="Diagnostic en direct" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Identity" Foreground="#9FB3C1" Margin="0,4,0,12"/></StackPanel></DockPanel>
  <Border Grid.Row="1" Background="#20343E" Padding="14" CornerRadius="8"><StackPanel><TextBlock x:Name="Metrics" FontSize="16" TextWrapping="Wrap"/><TextBlock x:Name="Memory" Margin="0,8,0,0" Foreground="#B5C6D2" TextWrapping="Wrap"/><TextBlock x:Name="Runtime" Margin="0,6,0,0" Foreground="#B5C6D2" TextWrapping="Wrap"/></StackPanel></Border>
  <StackPanel Grid.Row="2" Margin="0,12"><TextBlock x:Name="Counters" TextWrapping="Wrap" Foreground="#9ED8D1"/><TextBlock x:Name="AnalysisStatus" Text="Analyse en cours…" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
  <TabControl Grid.Row="3" Background="#192630" BorderThickness="0">
   <TabItem Header="Analyse automatique"><DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="Signaux indicatifs, pas preuve d’un bug. Règles locales sur les dernières observations ; les alertes disparaissent quand leurs conditions cessent. CPU/allocations : 8 s minimum ; mémoire : environ 60 s." TextWrapping="Wrap" Foreground="#9FB3C1" Margin="0,0,0,14"/><ListView x:Name="AnalysisList"><ListView.ItemTemplate><DataTemplate><Border Background="#263842" Padding="14" CornerRadius="7" Margin="0,0,0,8" MaxWidth="960"><StackPanel><TextBlock Text="{Binding Title}" Foreground="#FFBE78" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Advice}" Foreground="#B5C6D2" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView></DockPanel></TabItem>
   <TabItem Header="Opérations en cours"><ListView x:Name="ActiveList" ItemTemplate="{StaticResource OperationRow}"/></TabItem>
   <TabItem Header="Activité récente"><ListView x:Name="RecentList"><ListView.View><GridView><GridViewColumn Header="Heure" Width="90" DisplayMemberBinding="{Binding LocalStarted, StringFormat={}{0:HH:mm:ss}}"/><GridViewColumn Header="ID" Width="65" DisplayMemberBinding="{Binding Id}"/><GridViewColumn Header="Catégorie" Width="100" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Opération" Width="245" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Durée (ms)" Width="105" DisplayMemberBinding="{Binding Milliseconds, StringFormat={}{0:F1}}"/><GridViewColumn Header="Résultat" Width="180" DisplayMemberBinding="{Binding Result}"/></GridView></ListView.View></ListView></TabItem>
   <TabItem Header="Requêtes et cumuls"><ListView x:Name="SummaryList"><ListView.View><GridView><GridViewColumn Header="Catégorie" Width="130" DisplayMemberBinding="{Binding Category}"/><GridViewColumn Header="Terminées" Width="115" DisplayMemberBinding="{Binding Completed}"/><GridViewColumn Header="Actives" Width="90" DisplayMemberBinding="{Binding Active}"/><GridViewColumn Header="Erreurs / HTTP ≥ 400" Width="175" DisplayMemberBinding="{Binding Errors}"/><GridViewColumn Header="Annulations / délais" Width="175" DisplayMemberBinding="{Binding Cancelled}"/><GridViewColumn Header="Moyenne (ms)" Width="125" DisplayMemberBinding="{Binding AverageMs, StringFormat={}{0:F1}}"/></GridView></ListView.View></ListView></TabItem>
   <TabItem Header="Threads du processus"><ListView x:Name="ThreadList"><ListView.View><GridView><GridViewColumn Header="Thread Windows" Width="170" DisplayMemberBinding="{Binding Id}"/><GridViewColumn Header="État observé" Width="180" DisplayMemberBinding="{Binding State}"/><GridViewColumn Header="Temps CPU cumulé (ms)" Width="220" DisplayMemberBinding="{Binding CpuMs, StringFormat={}{0:F1}}"/></GridView></ListView.View></ListView></TabItem>
  </TabControl>
  <TextBlock Grid.Row="4" Margin="0,12,0,0" FontSize="11" Foreground="#829CAB" TextWrapping="Wrap" Text="Relevé toutes les secondes, CPU rapporté à la capacité totale du PC. RAM de ce processus uniquement. Les tâches asynchrones partagent les threads : leur durée inclut les attentes, pas uniquement le CPU. HTTP : temps jusqu’aux en-têtes ; les chargements englobent lecture et traitement. Journal limité aux 200 dernières opérations, cumuls depuis le lancement. Aucune URL, identité ou clé enregistrée."/>
 </Grid>
</Window>
