<Application x:Class="Rift.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml" ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Background" Value="#D6BE83"/><Setter Property="Foreground" Value="#10151A"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="130"/><Setter Property="Foreground" Value="#10151A"/></Style>
  </Application.Resources>
</Application>
